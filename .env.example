PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# JWT — gere um valor forte (nunca reaproveite o de dev), mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens do navegador liberadas a chamar a API (painel + app do cliente),
# separadas por vírgula. Em produção é OBRIGATÓRIO definir — sem isso a API
# libera qualquer origem e avisa no log.
#   CORS_ORIGINS=https://painel.suapadaria.com,https://app.suapadaria.com
CORS_ORIGINS=

# Push notifications (Web Push/VAPID) — envio das campanhas para o app do
# cliente. Gere o par de chaves com:
#   npx web-push generate-vapid-keys
# A chave pública precisa ser a MESMA configurada em VITE_VAPID_PUBLIC_KEY no
# frontend-fidelizacao/.env. Sem essas variáveis, campanhas são marcadas como
# enviadas mas nenhuma notificação é disparada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suapadaria.com
