# Dependências e build
node_modules
dist
*.tsbuildinfo

# Variáveis de ambiente — nunca versionar segredo real. .env.example é só
# modelo (sem valor sensível) e fica versionado.
.env
.env.*
!.env.example

# Migrations: por pedido do time, não sobem pro repositório. Ficam só no
# ambiente local / já aplicadas no banco. Se clonar num ambiente novo,
# recrie a pasta e reaplique manualmente (ver README/memória do projeto).
migrations

# Configs de editor podem guardar credenciais de teste em texto puro (ex.:
# rest-client.environmentVariables do REST Client) — nunca versionar.
.vscode
.idea

# Ambiente local do REST Client (src/testes/*.http) — tem CPF/senha de seed
# em texto puro. O .example fica versionado como modelo vazio.
src/testes/http-client.env.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
